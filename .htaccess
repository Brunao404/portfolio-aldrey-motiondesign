# ============================================================
#  ALDREY RAMOS — .htaccess
#  Hostinger / Apache
# ============================================================

# ── Forçar HTTPS ──────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Remover www (canonical) ───────────────────────────────
# Descomente as linhas abaixo se quiser canonical sem www:
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ── Página de erro personalizada ─────────────────────────
ErrorDocument 404 /404.html

# ── Headers de segurança ──────────────────────────────────
<IfModule mod_headers.c>

  # HSTS — força HTTPS por 1 ano em todos os subdomínios
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Bloquear carregamento em iframes (Clickjacking)
  Header always set X-Frame-Options "DENY"

  # Bloquear detecção automática de MIME type
  Header always set X-Content-Type-Options "nosniff"

  # Controlar referrer
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissões de browser APIs
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content Security Policy
  # Ajuste os domínios conforme necessário
  Header always set Content-Security-Policy "\
default-src 'self'; \
script-src 'self' 'unsafe-inline'; \
style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
font-src 'self' https://fonts.gstatic.com; \
img-src 'self' data: https://drive.google.com https://lh3.googleusercontent.com https://www.google.com; \
frame-src https://drive.google.com; \
object-src 'none'; \
base-uri 'self'; \
form-action 'self' mailto:; \
upgrade-insecure-requests;"

</IfModule>

# ── Proteger admin.html por IP ────────────────────────────
# Substitua 0.0.0.0 pelo seu IP real (veja em: meuip.com.br)
# Se não souber ou o IP mudar, comente este bloco.
<Files "admin.html">
  Order Deny,Allow
  Deny from all
  Allow from 0.0.0.0
</Files>

# ── Bloquear acesso direto a arquivos sensíveis ───────────
<FilesMatch "\.(htaccess|htpasswd|env|log|sh|bak|sql|git)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ── Desabilitar listagem de diretórios ────────────────────
Options -Indexes

# ── Cache de assets estáticos ─────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css             "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg           "access plus 6 months"
  ExpiresByType image/png            "access plus 6 months"
  ExpiresByType image/webp           "access plus 6 months"
  ExpiresByType image/gif            "access plus 6 months"
  ExpiresByType image/svg+xml        "access plus 6 months"
  ExpiresByType font/woff2           "access plus 1 year"
  ExpiresByType font/woff            "access plus 1 year"
  ExpiresByType text/html            "access plus 0 seconds"
</IfModule>

# ── Compressão Gzip ───────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>
